# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
*.swp

# setuptools_scm auto-generated version file (regenerated on build/install)
jwst_gc_pipeline/version.py

# SLURM job output captured into the working tree
slurm-*.out

# Local scratch / benchmark / scratch-note artifacts (never committed)
_bench/
_*.txt
_*.md
TODO*.md
NOTES*.md

# PNGs are ignored by default (paper figures live in the Overleaf astrometry-paper
# project).  Small evidence figures that a README or issue embeds are the exception:
# they go under docs/evidence/<topic>/ and are force-added (`git add -f`), e.g.
# docs/evidence/satstar_*/.  Do not remove those tracked PNGs.
*.png
